# Neon pooled connection string, PostGIS extension enabled.
# See the "Neon + PostGIS" section of the Phase 0 procurement checklist.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed into /curate (the catalogue
# hand-verification queue).
CURATOR_EMAILS=

# OpenAI (src/infra/openai.ts). Trip generation (Phase 2), the watch layer's
# judge (Phase 3) and the briefing composer (Phase 4) all refuse to run without
# it; a quiet briefing needs no model and is still written.
OPENAI_API_KEY=

# Vercel Cron's bearer token, checked by every /api/cron/* route — these are
# public URLs, and an unauthenticated one can make the system spend money.
# Unset, the routes refuse rather than run.
CRON_SECRET=

# Open-Meteo. Unset, the free tier is used, which is CC BY 4.0 and licensed for
# non-commercial use only — fine for development, not for a paid product.
OPEN_METEO_API_KEY=

# Trigger.dev — the watch pipeline's clock (src/trigger/watch-pipeline.ts). Only
# the CLI reads this; the Next app never does. The project ref is committed in
# trigger.config.ts. The tasks themselves read APP_URL and CRON_SECRET from the
# Trigger.dev environment, not from here.
TRIGGER_SECRET_KEY=

# Resend — the daily briefing's only delivery channel (Phase 4). Unset, the
# briefing is still composed, stored and shown in the app; only the email is
# skipped, and `briefing.email_error` records why.
RESEND_API_KEY=
# The verified sending identity, e.g. "trip.io <briefing@yourdomain>".
BRIEFING_FROM=

# The origin every link in a briefing email points at, no trailing slash. Also
# read by the Trigger.dev tasks from their own environment, not from here.
APP_URL=http://localhost:3000
