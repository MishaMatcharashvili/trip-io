# Neon pooled connection string, PostGIS extension enabled.
# See the "Neon + PostGIS" section of the Phase 0 procurement checklist.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed into /curate (the catalogue
# hand-verification queue).
CURATOR_EMAILS=

# OpenAI (src/infra/openai.ts). Trip generation (Phase 2), the watch layer's
# judge (Phase 3) and the briefing composer (Phase 4) all refuse to run without
# it; a quiet briefing needs no model and is still written.
OPENAI_API_KEY=

# Vercel Cron's bearer token, checked by every /api/cron/* route — these are
# public URLs, and an unauthenticated one can make the system spend money.
# Unset, the routes refuse rather than run.
CRON_SECRET=

# Open-Meteo. Unset, the free tier is used, which is CC BY 4.0 and licensed for
# non-commercial use only — fine for development, not for a paid product.
OPEN_METEO_API_KEY=

# OSRM, used only by `npm run catalogue:corridors` when it builds the road
# corridors offline. Unset, the FOSSGIS instance is used. The app's map and
# routes do not use it: they use the Mapbox tokens below.
OSRM_URL=

# Trigger.dev — the watch pipeline's clock (src/trigger/watch-pipeline.ts). Only
# the CLI reads this; the Next app never does. The project ref is committed in
# trigger.config.ts. The tasks themselves read APP_URL and CRON_SECRET from the
# Trigger.dev environment, not from here.
TRIGGER_SECRET_KEY=

# Resend — the daily briefing's only delivery channel (Phase 4). Unset, the
# briefing is still composed, stored and shown in the app; only the email is
# skipped, and `briefing.email_error` records why.
RESEND_API_KEY=
# The verified sending identity, e.g. "trip.io <briefing@yourdomain>".
BRIEFING_FROM=

# The origin every link in a briefing email points at, no trailing slash. Also
# read by the Trigger.dev tasks from their own environment, not from here.
APP_URL=http://localhost:3000

# Push delivery (Phase 5). Optional: Expo's service needs no key, because the
# APNs and FCM credentials live in EAS. Set this only after enabling "enhanced
# push security" on the Expo project, which then refuses unsigned pushes.
EXPO_ACCESS_TOKEN=

# The road-report bot (Phase 5, detector #2). From @BotFather. Unset, the
# webhook refuses with 503 and nothing else changes.
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back on every update, and the
# webhook refuses updates without it: the URL is public.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user ids. Their reports publish at once, and
# everyone else's come to them for approval. Ask @userinfobot for yours.
TELEGRAM_OPERATOR_IDS=


# Mapbox. Two tokens, two jobs — see docs/mapbox.md.
# Browser token: a PUBLIC token (pk.), URL-restricted in Mapbox to this app's
# origins (production, preview, http://localhost:3000). It ships in the client
# bundle by design, and the schema rejects anything that is not pk.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional Mapbox Studio styles (mapbox://styles/...). Unset, Mapbox's light-v11
# and dark-v11 are used.
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=
NEXT_PUBLIC_MAPBOX_STYLE_DARK=
# Optional Studio style for the Terrain choice. Unset, Mapbox's outdoors-v12.
NEXT_PUBLIC_MAPBOX_STYLE_TERRAIN=
# Server token for the Directions API: an ordinary second token (pk. or sk.,
# default public scopes, no URL restriction), never the browser's own. Never
# NEXT_PUBLIC_, never in the browser.
# Unset, routes answer "not configured" and the map shows stops without a road.
MAPBOX_DIRECTIONS_TOKEN=
# What the routes proxy will spend before it refuses (src/bll/route.ts). Unset,
# the defaults apply: 20 a minute and 200 a day per traveller, 200 a minute and
# 1000 a day in all. Mapbox's own ceiling is 300 a minute.
ROUTES_USER_PER_MINUTE=
ROUTES_USER_PER_DAY=
ROUTES_GLOBAL_PER_MINUTE=
ROUTES_GLOBAL_PER_DAY=

# Tripadvisor Terra (src/infra/tripadvisor.ts): the rating, reviews and photos on
# a place. Discover tier: 1,000 free billable entities for the account's life,
# then a cent and a half each. A place opened is about three. Only its id is kept
# in Postgres; what it says is kept in Redis for a few hours (below) — which its
# caching policy does not obviously allow: read docs/tripadvisor.md first.
# Unset, places show without them.
TRIPADVISOR_API_KEY=
# What opening places may cost (src/bll/place-enrichment.ts). Unset, the defaults
# apply: 60 a day per traveller and 500 a day in all. A place served from Redis
# is not counted against the day's total.
TRIPADVISOR_USER_PER_DAY=
TRIPADVISOR_GLOBAL_PER_DAY=
# Seconds what Tripadvisor said is kept in Redis. Unset, 43200 (12 hours); 0 keeps nothing.
TRIPADVISOR_CONTENT_TTL_S=
# Upstash Redis, REST (Vercel's Redis integration sets both). Unset, nothing is
# kept and every visit asks Tripadvisor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places API (New) (src/infra/google-places.ts): a second rating, reviews
# and photos on a place, beside Tripadvisor's. Create the key in Google Cloud ->
# APIs & Services -> Credentials, enable "Places API (New)" and billing, and
# restrict the key to that API. Server-only; never NEXT_PUBLIC_. What Google says
# is kept in Redis for 60 days (below) — which its terms do not obviously allow:
# read docs/google-places.md first.
# Unset, the panel shows Tripadvisor's alone.
GOOGLE_PLACES_API_KEY=
# What opening places may cost on Google. Unset, the defaults apply: 30 a day per
# traveller and 200 a day in all. A place served from Redis is not counted against
# the day's total.
GOOGLE_PLACES_USER_PER_DAY=
GOOGLE_PLACES_GLOBAL_PER_DAY=
# Seconds what Google said is kept in Redis (needs the Upstash variables below).
# Unset, 5184000 (60 days); 0 keeps nothing.
GOOGLE_PLACES_CONTENT_TTL_S=
