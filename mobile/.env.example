# Where the app finds the web package's API. From a phone on the same network,
# use the dev machine's LAN address rather than localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
# A build made without it opens on a screen that says so. For a TestFlight or
# internal-track build, set it as an EAS environment variable, not here.

# A public Mapbox token (pk.) for the maps over a trip. Its own token, with no
# URL restriction: the web app's is restricted to its URLs. Without it the
# maps are left out and the screens still work.
EXPO_PUBLIC_MAPBOX_TOKEN=
